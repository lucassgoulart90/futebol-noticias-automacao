# Configurações de Email para automação de novidades
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
EMAIL_FROM=seu_email@gmail.com
# Múltiplos destinatários separados por vírgula
EMAIL_DESTINATARIOS=email1@example.com,email2@example.com,email3@example.com

# Chave do Firebase para API do Grêmio
GREMIO_FIREBASE_KEY=sua_chave_firebase_aqui
